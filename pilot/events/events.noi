(module events 1.0.0
  ; A CI dispatcher accepts a typed delivery envelope from its webhook adapter.
  (record envelope (repository repository) (change change) (labels labels))
  (record repository (slug text) (archived bool))
  (enum change (other) (push push))
  (record push (ref optional_ref) (deleted bool))
  (enum optional_ref (missing) (present text))
  (sequence labels text 128)
  (record job (repository text) (branch text) (urgent bool))
  (enum dispatch (ignored) (invalid) (queue job))

  (helper branch_job ((slug text) (ref text) (urgent bool)) dispatch (reads)
    (requires true)
    (ensures (match result (ignored true) (invalid true)
      (queue j (and (= (get j repository) slug)
        (and (= (get j urgent) urgent)
          (and (not (= (get j branch) "")) (= (get j branch) (strip-prefix ref "refs/heads/"))))))))
    (if (starts-with ref "refs/heads/")
      (let branch (strip-prefix ref "refs/heads/")
        (if (= branch "") (tag dispatch invalid)
          (tag dispatch queue (make job (repository slug) (branch branch) (urgent urgent)))))
      (tag dispatch ignored)))

  (fn dispatch_push ((delivery envelope) (signature_note text)) dispatch
    (reads)
    (independent signature_note)
    (requires true)
    (ensures (match result (ignored true) (invalid true)
      (queue j (and (not (get (get delivery repository) archived))
        (and (= (get j repository) (get (get delivery repository) slug))
          (and (= (get j urgent) (member (get delivery labels) "ci:urgent"))
            (not (= (get j branch) ""))))))))
    (let repo (get delivery repository)
      (if (get repo archived) (tag dispatch ignored)
        (if (= (get repo slug) "") (tag dispatch invalid)
          (match (get delivery change)
            (other (tag dispatch ignored))
            (push p (if (get p deleted) (tag dispatch ignored)
              (match (get p ref)
                (missing (tag dispatch invalid))
                (present r (call branch_job (get repo slug) r
                  (member (get delivery labels) "ci:urgent"))))))))))))
