(module topics 1.0.0
  (record request (actor actor) (topic topic))
  (record actor (tenant uuid) (disabled bool) (grant scope))
  (record topic (tenant uuid) (key text))
  (enum scope (none) (exact text) (subtree text))
  (enum decision (allow) (unavailable) (protected) (outside_scope))

  (fn authorize ((req request) (trace text)) decision
    (reads system_topics)
    (independent trace)
    (requires true)
    (ensures
      (or (not (= result (tag decision allow)))
        (let a (get req actor)
          (let t (get req topic)
            (let k (get t key)
              (and (= (get a tenant) (get t tenant))
                (and (not (get a disabled))
                  (and (not (= k ""))
                    (and (or (flag system_topics) (not (starts-with k "system/")))
                      (match (get a grant)
                        (none false)
                        (exact id (= id k))
                        (subtree root (and (ends-with root "/")
                          (and (starts-with k root) (not (= k root)))))))))))))))
    (let a (get req actor)
      (let t (get req topic)
        (let k (get t key)
          (if (or (get a disabled) (or (not (= (get a tenant) (get t tenant))) (= k "")))
            (tag decision unavailable)
            (if (and (starts-with k "system/") (not (flag system_topics)))
              (tag decision protected)
              (let in_scope (match (get a grant)
                  (none false) (exact id (= k id))
                  (subtree root (and (ends-with root "/")
                    (and (starts-with k root) (not (= root k))))))
                (if in_scope (tag decision allow) (tag decision outside_scope))))))))))
