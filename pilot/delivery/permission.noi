(module delivery 1.1.0
  (enum receipt (pending) (received byte))
  (fn acknowledge ((status receipt) (sequence byte)) receipt
    (reads audit)
    (requires true)
    (ensures (match result
      (pending false)
      (received id (= id (match status (pending sequence) (received prior prior))))))
    (match status
      (pending (tag receipt received sequence))
      (received prior status))))
