{
  "name": "noitak",
  "version": "0.10.0",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "test:symbolic": "node --test tests/symbolic/*.test.mjs",
    "pilot": "node pilot/delivery/run.mjs",
    "pilot:support": "node pilot/support/run.mjs",
    "demo": "node examples/demo.mjs",
    "pilot:batch": "node pilot/support/run-batch.mjs",
    "release:check": "node scripts/release.mjs",
    "pilot:components": "node pilot/topics/compare.mjs",
    "pilot:collect": "node pilot/collect/run.mjs",
    "pilot:inventory": "node pilot/inventory/run.mjs",
    "bench:changes": "node pilot/coldchain/benchmark.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "typescript": "5.9.3"
  },
  "description": "Verification-first language for composable programs and capability-scoped host services",
  "bin": {
    "noitak": "noitak.mjs"
  },
  "files": [
    "noitak.mjs",
    "noi.mjs",
    "src/*.mjs",
    "src/compiled-runtime.js.inc",
    "src/symbolic_worker.py",
    "requirements-symbolic.txt",
    "docs/language.md",
    "docs/verification.md",
    "docs/philosophy.md",
    "docs/architecture.md",
    "docs/release-0.5.md",
    "docs/release-0.6.md",
    "docs/release-0.7.md",
    "pilot/metering/metering.noi",
    "pilot/metering/service.mts",
    "pilot/metering/demo.mjs",
    "pilot/metering/reference.mts",
    "pilot/access/access.noi",
    "examples/quota.noi",
    "pilot/support/support.noi",
    "pilot/support/batch.noi",
    "docs/release-0.8.md",
    "pilot/events/events.noi",
    "pilot/events/vectors.json",
    "pilot/topics/topics.noi",
    "pilot/topics/vectors.json",
    "pilot/topics/service.mts",
    "pilot/topics/reference.mts",
    "docs/release-0.9.md",
    "pilot/events/collect.noi",
    "pilot/collect/vectors.json",
    "pilot/collect/service.mts",
    "pilot/collect/reference.mts",
    "src/lookup-runtime.js.inc",
    "docs/release-0.10.md",
    "pilot/inventory/inventory.noi",
    "pilot/inventory/service.mts",
    "pilot/coldchain/*.noi",
    "pilot/coldchain/*.mts",
    "pilot/coldchain/vectors.json"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/janmrow/noitak.git"
  }
}
